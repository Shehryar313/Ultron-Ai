# Ultron AI Companion — Environment Variables
# Get your free Gemini API key from: https://aistudio.google.com/apikey

GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# MongoDB Connection String (Local or MongoDB Atlas)
# Local: mongodb://127.0.0.1:27017/ultron
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/ultron?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ultron
